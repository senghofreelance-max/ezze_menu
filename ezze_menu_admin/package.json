{
	"name": "ezze_menu_admin",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --port 8087",
		"build": "vite build && node ../frontend/shared/scripts/sync-html.mjs ../ezze_menu/public/menu_admin/index.html ../ezze_menu/www/menu-admin.html",
		"preview": "vite preview",
		"copy-html-entry": "mkdir -p ../ezze_menu/www && cp ../ezze_menu/public/menu_admin/index.html ../ezze_menu/www/menu-admin.html",
		"tw:init": "tailwindcss init -p",
		"tw:build": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch"
	},
	"dependencies": {
		"@casl/ability": "^6.8.0",
		"@casl/vue": "^2.2.6",
		"frappe-js-sdk": "^1.12.0",
		"pinia": "^3.0.3",
		"primeicons": "^7.0.0",
		"primevue": "^4.5.4",
		"vue": "^3.5.24",
		"vue-router": "^4.5.1"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^6.0.1",
		"autoprefixer": "^10.4.23",
		"postcss": "^8.5.6",
		"tailwindcss": "^3.4.17",
		"vite": "^7.2.4"
	}
}
